@{
}
@model kurs.Models.Zakaz

@{
    ViewData["Title"] = "Удаление";
}

<h2>Вы уверены что хотите удалить этот заказ?</h2>

<table class="table">
    <tr>
        <th>Order ID</th>
        <td>@Model.IdZakaz</td>
    </tr>
    <tr>
        <th>Order Date</th>
        <td>@Model.ZakazData.ToShortDateString()</td>
    </tr>
    <tr>
        <th>Order Sum</th>
        <td>@Model.ZakazSumma</td>
    </tr>
    <tr>
        <th>Customer ID</th>
        <td>@Model.IdPokupatel</td>
    </tr>
    <tr>
        <th>Order Picker ID</th>
        <td>@Model.IdSborschikZakaza</td>
    </tr>
    <tr>
        <th>Delivery ID</th>
        <td>@Model.IdDostavka</td>
    </tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdZakaz" />
    <button type="submit" class="btn btn-danger">Delete Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>