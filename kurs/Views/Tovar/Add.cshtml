@{
}
@model kurs.Models.Tovar

@{
    ViewData["Title"] = "Добавить товар";
}

<h2>Добавить новый товар</h2>

<form asp-action="Add" method="post">
    <div class="form-group">
        <label for="Cena">Цена:</label>
        <input type="number" step="any" name="Cena" class="form-control" required />
        <span asp-validation-for="Cena" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Kolichestvo">Количество:</label>
        <input type="number" name="Kolichestvo" class="form-control" required />
        <span asp-validation-for="Kolichestvo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="TovarNaimenovanie">Наименование товара:</label>
        <input type="text" name="TovarNaimenovanie" class="form-control" required />
        <span asp-validation-for="TovarNaimenovanie" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="IdZakaz">ID заказа:</label>
        <select name="IdZakaz" class="form-control" asp-items="ViewBag.IdZakaz"></select>
    </div>

    <button type="submit" class="btn btn-primary">Добавить товар</button>
</form>