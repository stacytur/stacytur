@{
}
@model kurs.Models.Pokupatel

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders for @Model.PokupatelFio</h1>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Sum</th>
            <!-- Другие заголовки -->
        </tr>
    </thead>
    <tbody>
        @foreach (var zakaz in Model.Zakaz)
        {
            <tr>
                <td>@zakaz.ZakazData.ToString("dd.MM.yyyy")</td>
                <td>@zakaz.ZakazSumma</td>
                <!-- Другие ячейки -->
            </tr>
        }
    </tbody>
</table>