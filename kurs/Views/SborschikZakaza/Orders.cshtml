
@model kurs.Models.SborschikZakaza

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders for @Model.SborschikZakazaNames</h1>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Sum</th>
           
        </tr>
    </thead>
    <tbody>
        @foreach (var zakaz in Model.Zakaz)
        {
                <tr>
                    <td>@zakaz.ZakazData.ToString("dd.MM.yyyy")</td>
                    <td>@zakaz.ZakazSumma</td>
                  
                </tr>
        }
    </tbody>
</table>
