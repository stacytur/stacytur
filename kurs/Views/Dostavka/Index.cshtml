@model IEnumerable<kurs.Models.Dostavka>

@{
    ViewData["Title"] = "Список доставок";
}

<h1>Список доставок</h1>

<a asp-controller="Dostavka" asp-action="Create" class="btn btn-primary">Добавить новую доставку</a>

<form asp-action="Index" method="get" class="form-inline mb-3">
    
    <div class="form-group mr-2">
        <label for="searchStatus" class="mr-2">Статус доставки:</label>
        <input type="text" name="searchStatus" id="searchStatus" value="@ViewData["CurrentSearchStatus"]" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Поиск</button>
    <a asp-action="Index" class="btn btn-secondary ml-2">Сбросить</a>
</form>

<table class="table">
    <thead>
        <tr>
            
            <th><a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]">ID</a></th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DataPolucheniyaSortParm"]">Дата получения</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["OjdaemayaDataSortParm"]">Ожидаемая дата</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StatusDostavkiSortParm"]">Статус доставки</a>
            </th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdDostavka</td>
                <td>@item.DataPolucheniya.ToString("dd.MM.yyyy")</td>
                <td>@item.OjdaemayaData.ToString("dd.MM.yyyy")</td>
                <td>@item.StatusDostavki</td>
                <td>
                  

                    <a asp-action="Edit" asp-route-id="@item.IdDostavka" class="btn btn-info">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.IdDostavka" class="btn btn-danger">Delete</a>
                    <a asp-controller="Dostavka" asp-action="Orders" asp-route-id="@item.IdDostavka" class="btn btn-primary">View Orders</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="text-center mt-5">
    <img src="~/images/niz4.jpg" alt="Bottom Image" class="img-fluid" />
</div>