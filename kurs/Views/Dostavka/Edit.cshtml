
@model kurs.Models.Dostavka

<h1>Редактировать доставку</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="IdDostavka" />
    <div class="form-group">
        <label asp-for="DataPolucheniya" class="control-label"></label>
        <input asp-for="DataPolucheniya" class="form-control" />
        <span asp-validation-for="DataPolucheniya" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OjdaemayaData" class="control-label"></label>
        <input asp-for="OjdaemayaData" class="form-control" />
        <span asp-validation-for="OjdaemayaData" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StatusDostavki" class="control-label"></label>
        <input asp-for="StatusDostavki" class="form-control" />
        <span asp-validation-for="StatusDostavki" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
    </div>
</form>